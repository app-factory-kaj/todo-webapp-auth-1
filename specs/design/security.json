{
  "version": 3,
  "permissions": [
    {
      "resource": "todos",
      "component": "todo-api",
      "description": "A User's own todo items",
      "actions": [
        { "handle": "read", "description": "The caller's own todo items" },
        { "handle": "write", "description": "Create, edit, complete and delete the caller's own todo items" }
      ]
    }
  ],
  "groups": [],
  "roles": [
    {
      "name": "User",
      "description": "A signed-in person who manages their own private todo list.",
      "stories": [1, 2, 3, 4, 5, 6, 7],
      "grants": ["todos:read", "todos:write"],
      "enrolment": "self-service"
    }
  ],
  "testUsers": [
    { "username": "test-user", "roles": ["User"] },
    { "username": "test-user-2", "roles": ["User"] }
  ]
}
